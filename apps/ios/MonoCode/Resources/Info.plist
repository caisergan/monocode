<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(MC_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Direct channels are ws:// to private addresses (05 §5.3); the
		     Noise channel inside carries the security. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<!-- Tailscale MagicDNS names (05 §5.2). -->
			<key>ts.net</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>MonoCode scans the pairing code your computer shows.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>MonoCode connects directly to your computers on the same Wi-Fi.</string>
	<key>MCTrack</key>
	<string>$(MC_TRACK)</string>
	<key>MCURLScheme</key>
	<string>$(MC_URL_SCHEME)</string>
</dict>
</plist>
